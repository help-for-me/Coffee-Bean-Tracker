EXTRACTOR_PROVIDER=claude          # "claude" for MVP; "ollama" reserved for 1.6.0
CLAUDE_MODEL=claude-haiku-4-5-20251001
ANTHROPIC_API_KEY=your-key-here
APP_PORT=8000
PHOTOS_PATH=/app/data/photos

RECENT_WINDOW_MONTHS=4              # MVP: fixed, no Settings UI until 1.7.0
RECENT_WINDOW_COUNT=10              # MVP: fixed, no Settings UI until 1.7.0

