EXTRACTOR_PROVIDER=claude          # "claude" for MVP; "ollama" reserved for 1.3.0
NARRATIVE_PROVIDER=claude          # "claude" for MVP; "ollama" reserved for 1.3.0
CLAUDE_MODEL=claude-haiku-4-5-20251001
ENRICHMENT_PROVIDER=claude         # "claude" only, built in 1.9.0
ENRICHMENT_MODEL=claude-sonnet-5   # separate from CLAUDE_MODEL - needs web search + more judgment than the haiku default
ANTHROPIC_API_KEY=your-key-here
APP_PORT=8000
PHOTOS_PATH=data/photos            # relative to the working directory - resolves correctly both locally and in Docker (WORKDIR /app)
ENRICHMENT_SOURCES_PATH=data/enrichment_sources   # same convention - saved roaster-website source text, one file per bean profile
LOG_PATH=data/logs/app.log         # same convention - grab this file directly from Unraid's file browser instead of the Docker UI's Logs panel

RECENT_WINDOW_MONTHS=4              # MVP: fixed, no Settings UI until 1.4.0
RECENT_WINDOW_COUNT=10              # MVP: fixed, no Settings UI until 1.4.0

# Below reserved for 1.1.0 data backup sinks, not used in MVP:
# LOCAL_XLSX_ENABLED=
# LOCAL_XLSX_PATH=
# GITHUB_BACKUP_ENABLED=
# GITHUB_TOKEN=
# GITHUB_REPO=
# GITHUB_BRANCH=
