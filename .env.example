EXTRACTOR_PROVIDER=claude          # "claude" for MVP; "ollama" reserved for 1.3.0
NARRATIVE_PROVIDER=claude          # "claude" for MVP; "ollama" reserved for 1.3.0
CLAUDE_MODEL=claude-haiku-4-5-20251001
ANTHROPIC_API_KEY=your-key-here
APP_PORT=8000
PHOTOS_PATH=data/photos            # relative to the working directory - resolves correctly both locally and in Docker (WORKDIR /app)
LOG_PATH=data/logs/app.log         # same convention - grab this file directly from Unraid's file browser instead of the Docker UI's Logs panel

RECENT_WINDOW_MONTHS=4              # MVP: fixed, no Settings UI until 1.4.0
RECENT_WINDOW_COUNT=10              # MVP: fixed, no Settings UI until 1.4.0

# 1.1.0 data backup sinks - CSV/XLSX download always work with no config;
# these only control whether triggering an XLSX export also saves a local
# copy, and whether the GitHub backup button is available at all.
# LOCAL_XLSX_ENABLED=true
# LOCAL_XLSX_PATH=exports/coffee-bean-tracker.xlsx   # under the mounted exports/ volume
# GITHUB_BACKUP_ENABLED=true
# GITHUB_TOKEN=your-personal-access-token             # needs Contents: read/write on the target repo
# GITHUB_REPO=yourusername/coffee-bean-tracker-backups  # a separate, dedicated private repo - not this one
# GITHUB_BRANCH=main
